# Public address the site is published at (no trailing slash).
# WhatsApp needs this to be the real, absolute URL for the link preview image.
VITE_SITE_URL=https://lostin404.github.io/ameen-aysha

# Folder the site is served from (leading and trailing slash).
# Use / if you later move to a custom domain or to Vercel.
VITE_BASE_PATH=/ameen-aysha/
